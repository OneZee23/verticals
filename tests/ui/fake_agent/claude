#!/usr/bin/env python3
"""A stand-in for `claude --print --input-format stream-json` in the UI suite: no model, no network. It answers each
message by marks in its words: `[tool:NAME]` calls Verticals' tool NAME, `[ask]` asks permission first, `[ask:NAME]` asks
permission for one of the writes in ASKS, shaped as the real tool is called, `[make:ID|Title]` makes the goal ID
by calling `create` and gets the words Verticals' server answers it with, `[slow]` works for a second and a half,
`[long]` answers in three paragraphs, `[fail]` ends the turn with an error, `[say]` answers with the words after it, and
`[context]` with the app context Verticals sent. Each start appends the arguments it was given to `argv.log` in its
folder, so a scenario can read what the gateway really asked of the CLI (its mode, tools and instructions). A message
that opens with "Check again" (a document's comments and edits handed over, web/src/lib/checkAgain.ts) works for a
second and a half, which is the time a test has to rewrite the document as the real agent would, then answers in two
lines. A message that opens with "Improve it" (a report's design asked for, web/src/lib/reportActions.ts) is answered as the
real agent answers it through Verticals' tools: it writes a design document into the report's task, linked to it, and says
it is waiting for the person's comments; this one reaches the API the tests' gateway was started with (FAKE_AGENT_API). A message that opens with "A person's report,
in their words" (a report to sort, desktop/chat/report_kind.py) is answered with one word, request when the words say what
the person would like ("I'd like", "would be nice", "I wish", "I want", "could be", "should be", "please add") and bug
otherwise, or with a sentence that names neither when they carry `[unclear]`."""
import json
import os
import re
import sys
import time
import urllib.request


def out(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def read():
    line = sys.stdin.readline()
    return json.loads(line) if line.strip() else None


CHECKED = "Check again"
IMPROVE = "Improve it"
SORT = "A person's report, in their words"
WISHES = ("i'd like", "i would like", "would be nice", "i wish", "i want", "could be", "should be", "please add")

# `[ask:NAME]`: a write the agent asks permission for. SYNDAY01 is "Draft the outline", a goal of 8 Aug 2026 in F2.
ASKS = {
    "schedule": ("schedule", {"id": "SYNDAY01", "vertical": "day", "anchor_date": "2026-08-10"}),
    "week": ("schedule", {"id": "SYNDAY01", "vertical": "week", "anchor_date": "2026-08-10"}),
    "clear": ("schedule", {"id": "SYNDAY01", "vertical": None, "anchor_date": None}),
    "create": ("create", {"title": "Plan the review", "vertical": "week", "anchor_date": "2026-08-10"}),
    "update": ("update", {"id": "SYNDAY01", "done": True}),
    "delete": ("delete", {"id": "SYNDAY01"}),
    "unknown": ("schedule", {"id": "SYNNOPE1", "vertical": "day", "anchor_date": "2026-08-10"}),
}


def api(method, path, body=None):
    """One call to the API the gateway was started over, as the Verticals tool the real agent would call."""
    request = urllib.request.Request(
        os.environ["FAKE_AGENT_API"] + path, method=method, data=json.dumps(body).encode() if body is not None else None,
        headers={"Authorization": "Bearer " + os.environ["FAKE_AGENT_TOKEN"], "Content-Type": "application/json"})
    with urllib.request.urlopen(request, timeout=10) as response:
        return json.loads(response.read() or b"null")


def improve(words):
    """What the real agent does when asked to improve a report (desktop/chat/prompt-report.md): a design document in the
    report's own task (doc_create, then doc_link by the task's notes), the one it has made already when it is asked again, and
    two short lines saying it waits."""
    goal = re.search(r"#goal/([A-Za-z0-9_-]+)", words).group(1)
    task = api("GET", f"/api/goals/{goal}")
    path = f"design/{goal}.md"
    title = f"Design — {task['title'][:60]}"
    doc = next((d for d in api("GET", "/api/docs")["docs"] if d["path"] == path), None)
    if doc is None:
        doc = api("POST", "/api/docs", {"path": path, "title": title,
                                        "body": "What went wrong, what you expected, the change and its tests.\n\nWaiting for your comments."})
    if f"doc:{path}" not in (task.get("body") or ""):
        api("PATCH", f"/api/goals/{goal}", {"body": ((task.get("body") or "") + f"\n\n[{title}](doc:{path})").strip()})
    return f"Wrote the design. Waiting for your comments.\n\n[{title}](#doc/{doc['id']})"


def sort_for(words):
    """What the real agent answers when it is asked to sort a report: one word, by the person's own words."""
    said = words.split("\n\n", 1)[-1].rsplit("\n\nIs it a bug or a request?", 1)[0].lower()
    if "[unclear]" in said:
        return "It is hard to say from this."
    return "request" if any(wish in said for wish in WISHES) else "bug"


def answer_for(words):
    if words.startswith(CHECKED):
        return "Changed the words you commented on.\nLeft the rest as it was."
    if "[say]" in words:
        return words.split("[say]", 1)[1].strip()
    if "[long]" in words:
        return ("Here is the first part of a longer answer, with **bold** words.\n\n"
                "The second part goes on about the plan, the dates and what could move next week.\n\n"
                "The third part closes it with one more line to read.")
    said = re.sub(r"\[(?:[a-z:_]+|make:[^\]]*)\]", "", words).strip()
    return f"Done: {said}" if said else "Done."


with open("argv.log", "a") as argv_log:
    argv_log.write(json.dumps(sys.argv[1:]) + "\n")

started = False
asked = 0
for msg in iter(read, None):
    kind = msg.get("type")
    if kind == "control_request":
        sub = msg.get("request", {}).get("subtype")
        if sub == "initialize":
            out({"type": "control_response", "response": {"subtype": "success", "request_id": msg["request_id"],
                 "response": {"models": [{"value": "fake-model", "displayName": "Fake model"}]}}})
        elif sub == "get_usage":
            out({"type": "control_response", "response": {"subtype": "success", "request_id": msg["request_id"],
                 "response": {"rate_limits_available": False}}})
        continue
    if kind != "user":
        continue
    text = "".join(block.get("text", "") for block in msg["message"]["content"] if block.get("type") == "text")
    words = text.split("</app_context>")[-1].strip()
    if "[context]" in words:
        words = "[say] " + text.split("<app_context>")[-1].split("</app_context>")[0].strip()
    if not started:
        out({"type": "system", "subtype": "init", "model": "fake-model"})
        started = True
    ask = re.search(r"\[ask(?::([a-z_]+))?\]", words)
    if ask:
        tool, tool_input = ASKS[ask.group(1)] if ask.group(1) else ("update", {"id": "x"})
        asked += 1
        out({"type": "control_request", "request_id": f"ask-{asked}", "request": {
            "subtype": "can_use_tool", "tool_name": f"mcp__verticals__{tool}", "input": tool_input}})
        while (reply := read()) is not None and reply.get("type") != "control_response":
            pass
    for name in re.findall(r"\[tool:([a-z_]+)\]", words):
        out({"type": "assistant", "message": {"content": [
            {"type": "tool_use", "id": f"tool-{name}", "name": f"mcp__verticals__{name}", "input": {}}]}})
        time.sleep(0.3)
        out({"type": "user", "message": {"content": [
            {"type": "tool_result", "tool_use_id": f"tool-{name}", "content": "ok"}]}})
    for goal, title in re.findall(r"\[make:([A-Za-z0-9_-]+)\|([^\]]*)\]", words):
        out({"type": "assistant", "message": {"content": [
            {"type": "tool_use", "id": f"make-{goal}", "name": "mcp__verticals__create", "input": {"title": title}}]}})
        time.sleep(0.3)
        # What the server's `create` tool says (verticals/mcp/tools.py), which tests/mcp pins.
        out({"type": "user", "message": {"content": [
            {"type": "tool_result", "tool_use_id": f"make-{goal}", "content": [{"type": "text", "text": f"Created {title!r} [{goal}]"}]}]}})
    fixed = None
    if words.startswith(IMPROVE):
        time.sleep(1.0)
        fixed = improve(words)
    elif words.startswith(SORT):
        fixed = sort_for(words)
    if "[slow]" in words or words.startswith(CHECKED):
        time.sleep(1.5)
    if "[fail]" in words:
        out({"type": "result", "is_error": True, "result": "The fake agent failed on purpose."})
        continue
    out({"type": "stream_event", "event": {"type": "message_start"}})
    out({"type": "stream_event", "event": {"type": "content_block_start", "content_block": {"type": "text"}}})
    for piece in re.findall(r"\S+\s*|\n+", fixed or answer_for(words)):
        out({"type": "stream_event", "event": {"type": "content_block_delta", "delta": {"type": "text_delta", "text": piece}}})
    out({"type": "result", "is_error": False, "result": ""})
