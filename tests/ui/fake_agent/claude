#!/usr/bin/env python3
"""A stand-in for `claude --print --input-format stream-json` in the UI suite: no model, no network. It answers each
message by marks in its words: `[tool:NAME]` calls Verticals' tool NAME, `[ask]` asks permission first, `[ask:NAME]` asks
permission for one of the writes in ASKS, shaped as the real tool is called, `[slow]` works for a second and a half,
`[long]` answers in three paragraphs, `[fail]` ends the turn with an error, `[say]` answers with the words after it, and
`[context]` with the app context Verticals sent. Each start appends the arguments it was given to `argv.log` in its
folder, so a scenario can read what the gateway really asked of the CLI (its mode, tools and instructions).

The morning report (docs/design/morning-quality.md) is played when `scenario.json` in the same folder says `"morning": true`:
the seat the gateway started it in (the writer, or the second agent that checks the report) does what that seat does against
the real server, as `fake_morning.py` says. Without the file, a morning ask is answered like any other message."""
import json
import re
import sys
import time

import fake_morning


def out(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def read():
    line = sys.stdin.readline()
    return json.loads(line) if line.strip() else None


# `[ask:NAME]`: a write the agent asks permission for. SYNDAY01 is "Draft the outline", a goal of 8 Aug 2026 in F2.
ASKS = {
    "schedule": ("schedule", {"id": "SYNDAY01", "vertical": "day", "anchor_date": "2026-08-10"}),
    "week": ("schedule", {"id": "SYNDAY01", "vertical": "week", "anchor_date": "2026-08-10"}),
    "clear": ("schedule", {"id": "SYNDAY01", "vertical": None, "anchor_date": None}),
    "create": ("create", {"title": "Plan the review", "vertical": "week", "anchor_date": "2026-08-10"}),
    "update": ("update", {"id": "SYNDAY01", "done": True}),
    "delete": ("delete", {"id": "SYNDAY01"}),
    "unknown": ("schedule", {"id": "SYNNOPE1", "vertical": "day", "anchor_date": "2026-08-10"}),
}


def tool_call(name):
    """A tool use and its result, as the CLI streams them: Verticals' tools by their short name, another server's in full."""
    full = name if name.startswith("mcp__") else f"mcp__verticals__{name}"
    out({"type": "assistant", "message": {"content": [{"type": "tool_use", "id": f"tool-{name}", "name": full, "input": {}}]}})
    time.sleep(0.05)
    out({"type": "user", "message": {"content": [{"type": "tool_result", "tool_use_id": f"tool-{name}", "content": "ok"}]}})


def scripted(words, text):
    """The words this seat of the morning answers with, or None to answer like any message. May end the process or never answer,
    as the scenario asks of the second agent."""
    global rounds, remembered
    api, ctx = fake_morning.Api(CONF), fake_morning.context_of(text)
    found = re.search(r"reports/morning/\d{4}-\d{2}-\d{2}\.md", words)
    remembered = found.group(0) if found else remembered  # asked again, it remembers which report it was reading
    if ROLE == "writer":
        if "these checks failed" in words:
            return fake_morning.write_report(SCENARIO, api, SCENARIO.get("ask", ""), ctx, tool_call, defects=False)
        if "Make my morning report" in words:
            SCENARIO["ask"] = words
            written = fake_morning.write_report(SCENARIO, api, words, ctx, tool_call)
            return "[fail]" if SCENARIO.get("writer_mode") == "fail_after_write" else written
        return None
    mode = SCENARIO.get("checker_mode")
    if mode == "silent":
        time.sleep(3600)
    if mode == "crash":
        sys.exit(3)
    again = "no verdict I could read" in words
    if mode == "garbage" or (mode == "garbage_once" and not again):
        return "The report looks fine to me."
    time.sleep(SCENARIO.get("checker_delay", 0))
    answer = fake_morning.check_report(SCENARIO, api, remembered, ctx, tool_call, rounds)
    rounds += 1
    return answer


def answer_for(words):
    if "[say]" in words:
        return words.split("[say]", 1)[1].strip()
    if "[long]" in words:
        return ("Here is the first part of a longer answer, with **bold** words.\n\n"
                "The second part goes on about the plan, the dates and what could move next week.\n\n"
                "The third part closes it with one more line to read.")
    said = re.sub(r"\[[a-z:_]+\]", "", words).strip()
    return f"Done: {said}" if said else "Done."


with open("argv.log", "a") as argv_log:
    argv_log.write(json.dumps(sys.argv[1:]) + "\n")

# The seat this process was started in, from the instructions the gateway gave it.
SYSTEM = next((sys.argv[i + 1] for i, arg in enumerate(sys.argv[:-1]) if arg == "--append-system-prompt"), "")
ROLE = ("checker" if "## This turn: the second check" in SYSTEM else "writer" if "## This turn: the morning report" in SYSTEM else None)
SCENARIO, CONF = fake_morning.load("scenario.json"), fake_morning.load("fake-agent.json")
SCRIPTED = bool(ROLE and SCENARIO and SCENARIO.get("morning") and CONF)
rounds, remembered = 0, ""

started = False
asked = 0
for msg in iter(read, None):
    kind = msg.get("type")
    if kind == "control_request":
        sub = msg.get("request", {}).get("subtype")
        if sub == "initialize":
            out({"type": "control_response", "response": {"subtype": "success", "request_id": msg["request_id"],
                 "response": {"models": [{"value": "fake-model", "displayName": "Fake model"}]}}})
        elif sub == "get_usage":
            out({"type": "control_response", "response": {"subtype": "success", "request_id": msg["request_id"],
                 "response": {"rate_limits_available": False}}})
        continue
    if kind != "user":
        continue
    text = "".join(block.get("text", "") for block in msg["message"]["content"] if block.get("type") == "text")
    words = text.split("</app_context>")[-1].strip()
    if "[context]" in words:
        words = "[say] " + text.split("<app_context>")[-1].split("</app_context>")[0].strip()
    said = scripted(words, text) if SCRIPTED else None
    if said is not None:
        words = "[say] " + said
    if not started:
        out({"type": "system", "subtype": "init", "model": "fake-model"})
        started = True
    ask = re.search(r"\[ask(?::([a-z_]+))?\]", words)
    if ask:
        tool, tool_input = ASKS[ask.group(1)] if ask.group(1) else ("update", {"id": "x"})
        asked += 1
        out({"type": "control_request", "request_id": f"ask-{asked}", "request": {
            "subtype": "can_use_tool", "tool_name": f"mcp__verticals__{tool}", "input": tool_input}})
        while (reply := read()) is not None and reply.get("type") != "control_response":
            pass
    for name in re.findall(r"\[tool:([a-z_]+)\]", words):
        out({"type": "assistant", "message": {"content": [
            {"type": "tool_use", "id": f"tool-{name}", "name": f"mcp__verticals__{name}", "input": {}}]}})
        time.sleep(0.3)
        out({"type": "user", "message": {"content": [
            {"type": "tool_result", "tool_use_id": f"tool-{name}", "content": "ok"}]}})
    if "[slow]" in words:
        time.sleep(1.5)
    if "[fail]" in words:
        out({"type": "result", "is_error": True, "result": "The fake agent failed on purpose."})
        continue
    out({"type": "stream_event", "event": {"type": "message_start"}})
    out({"type": "stream_event", "event": {"type": "content_block_start", "content_block": {"type": "text"}}})
    for piece in re.findall(r"\S+\s*|\n+", answer_for(words)):
        out({"type": "stream_event", "event": {"type": "content_block_delta", "delta": {"type": "text_delta", "text": piece}}})
    out({"type": "result", "is_error": False, "result": ""})
